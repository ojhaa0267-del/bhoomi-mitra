# ─────────────────────────────────────────────────────────────────────────────
# Bhoomi Mitra – Backend Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_TITLE=Bhoomi Mitra API
APP_VERSION=1.0.0
DEBUG=false
PORT=8000

# ── CORS: comma-separated list of allowed frontend origins ────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your Firebase service account private key JSON file.
FIREBASE_CREDENTIALS_PATH=credentials/firebase-adminsdk.json

# Set to "true" ONLY for local demos without a real Firebase project.
# Use Authorization: Bearer demo-citizen-token to access protected routes.
DEMO_BYPASS_AUTH=true

# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────────
POSTGRES_URI=postgresql://bhoomi_user:bhoomi_pass@localhost:5432/bhoomi_mitra_db

# ── ML Model ─────────────────────────────────────────────────────────────────
DELAY_MODEL_PATH=../ml_engine/delay_predictor_model.pkl

# ── LLM Voice Agent ───────────────────────────────────────────────────────────
# Option A: Groq API (https://console.groq.com – free tier available)
GROQ_API_KEY=

# Option B: Ollama / local OpenAI-compatible endpoint
# OPENAI_API_BASE_URL=http://localhost:11434/v1
